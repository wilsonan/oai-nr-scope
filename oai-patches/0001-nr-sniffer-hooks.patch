+int nr_ue_merge_dci_configs(fapi_nr_dl_config_request_t *dl_config, int first_new)
+{
+  int merged = 0;
+  int out = first_new;
+  for (int k = first_new; k < dl_config->number_pdus; k++) {
+    fapi_nr_dl_config_request_pdu_t *pdu = &dl_config->dl_config_list[k];
+    bool done = false;
+    if (pdu->pdu_type == FAPI_NR_DL_CONFIG_TYPE_DCI) {
+      const fapi_nr_dl_config_dci_dl_pdu_rel15_t *rel15 = &pdu->dci_config_pdu.dci_config_rel15;
+      for (int j = 0; j < first_new && !done; j++) {
+        fapi_nr_dl_config_request_pdu_t *prev = &dl_config->dl_config_list[j];
+        fapi_nr_dl_config_dci_dl_pdu_rel15_t *p = &prev->dci_config_pdu.dci_config_rel15;
+        if (prev->pdu_type != FAPI_NR_DL_CONFIG_TYPE_DCI || p->num_extra_rnti >= sizeofArray(p->extra_rnti)
+            || p->rnti == rel15->rnti || !same_pdcch_config(p, rel15))
+          continue;
+        p->extra_rnti[p->num_extra_rnti++] = rel15->rnti;
+        done = true;
+      }
+    }
+    if (done)
+      merged++;
+    else
+      dl_config->dl_config_list[out++] = *pdu;
+  }
+  dl_config->number_pdus = out;
+  return merged;
+}
