+      .dmrs_typeA_pos = mac->mib->dmrs_TypeA_Position,
+      .coreset0 = mac->mib->pdcch_ConfigSIB1.controlResourceSetZero,
+      .searchspace0 = mac->mib->pdcch_ConfigSIB1.searchSpaceZero,
+      .cell_barred = mac->mib->cellBarred,
+      .intra_freq_reselection = mac->mib->intraFreqReselection,
+      .fr2 = mac->frequency_range == FR2,
+  };
+  nr_sniffer_hook_mib(&sniffer_mib);
 }
 
