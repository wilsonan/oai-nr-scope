+/* Emit one GNB_MAC_DCI T-tracer event for a DCI that has just been filled for cell->frame.cell->slot.
+ * This is the gNB ground truth that nr-sniffer's DCI log is compared against. */
+void nr_mac_trace_dci(const nr_cell_sched_t *cell,
+                      const nfapi_nr_dl_dci_pdu_t *dci_pdu,
+                      const dci_pdu_rel15_t *dci,
+                      int dci_format,
+                      int rnti_type,
+                      int bwp_id,
+                      const NR_SearchSpace_t *ss,
+                      const NR_ControlResourceSet_t *coreset,
+                      int prb_start,
+                      int prb_len,
+                      int mcs_table,
+                      int tbs_bytes)
+{
+  T(T_GNB_MAC_DCI,
+    T_INT(cell->frame),
+    T_INT(cell->slot),
+    T_INT(dci_pdu->RNTI),
+    T_INT(rnti_type),
+    T_INT(dci_format),
+    T_INT(bwp_id),
+    T_INT(coreset->controlResourceSetId),
+    T_INT(ss->searchSpaceId),
+    T_INT(dci_pdu->AggregationLevel),
+    T_INT(dci_pdu->CceIndex),
+    T_INT(prb_start),
+    T_INT(prb_len),
+    T_INT(dci->mcs),
+    T_INT(mcs_table),
+    T_INT(tbs_bytes * 8),
+    T_INT(dci->ndi),
+    T_INT(dci->rv),
+    T_INT(dci->harq_pid.val));
+}
