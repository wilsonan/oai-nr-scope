+void nr_ue_mac_follow_rnti(module_id_t module_id, uint16_t rnti)
+{
+  NR_UE_MAC_INST_t *mac = get_mac_inst(module_id);
+  int ret = pthread_mutex_lock(&mac->if_mutex);
+  AssertFatal(!ret, "mutex failed %d\n", ret);
+  LOG_A(NR_MAC, "[UE %d] Following C-RNTI %04x with a known configuration\n", module_id, rnti);
+  mac->crnti = rnti;
+  mac->state = UE_CONNECTED;
+  nr_timer_start(&mac->time_alignment_timer);
+  ret = pthread_mutex_unlock(&mac->if_mutex);
+  AssertFatal(!ret, "mutex failed %d\n", ret);
+}
+
+/* a shadow MAC instance has no PHY: its PHY configuration and synchronisation requests go nowhere */
+static void sniffer_noop_phy_config(nr_phy_config_t *phy_config)
+{
+  (void)phy_config;
+}
+
+static void sniffer_noop_synch(nr_synch_request_t *synch_request)
+{
+  (void)synch_request;
+}
+
+static nr_ue_if_module_t sniffer_shadow_if = {
+    .phy_config_request = sniffer_noop_phy_config,
+    .synch_request = sniffer_noop_synch,
+};
+
+void nr_ue_mac_follow_shadow(NR_UE_MAC_INST_t *main, int instance, uint16_t rnti, NR_CellGroupConfig_t *cell_group)
+{
+  const NR_SIB1_t *sniffer_sib1 = nr_sniffer_hook_get_sib1();
+  if (instance <= 0 || !main->mib || !sniffer_sib1) {
+    LOG_E(NR_MAC, "nr-sniffer: cannot follow C-RNTI %04x (instance %d, MIB %p, SIB1 %p)\n", rnti, instance, main->mib, sniffer_sib1);
+    return;
+  }
+  NR_UE_MAC_INST_t *mac = get_mac_inst(instance);
+  if (mac) {
+    if (!mac->sniffer_shadow) {
+      LOG_E(NR_MAC, "nr-sniffer: MAC instance %d is not a shadow instance, not following C-RNTI %04x\n", instance, rnti);
+      return;
+    }
+    /* reused for another UE: drop the previous UE's dedicated configuration, keep the cell's */
+    LOG_I(NR_MAC, "nr-sniffer: reusing shadow MAC instance %d for C-RNTI %04x\n", instance, rnti);
+    nr_rrc_mac_config_req_reset(instance, GO_TO_IDLE_KEEP_CAMPED);
+    nr_ue_mac_flush_ul_config(mac);
+    for (int slot = 0; slot < mac->frame_structure.numb_slots_frame; slot++)
+      get_dl_config_request(mac, slot)->number_pdus = 0;
+    nr_rrc_mac_config_req_cg(instance, 0, 0, 0, cell_group, NULL);
+    mac->update_pdcch_config = true;
+    nr_ue_mac_follow_rnti(instance, rnti);
+    return;
+  }
+  mac = nr_l2_init_ue(instance, main->numerology, main->rx2tx_capability);
+  mac->sniffer_shadow = true;
+  mac->if_module = &sniffer_shadow_if;
+  /* what the PHY reports with the MIB (handle_bcch_bch()) */
+  mac->physCellId = main->physCellId;
+  mac->mib_ssb = main->mib_ssb;
+  mac->mib_additional_bits = main->mib_additional_bits;
+  mac->ssb_start_subcarrier = main->ssb_start_subcarrier;
+  mac->frequency_range = main->frequency_range;
+  mac->dl_frequency = main->dl_frequency; /* from the command line (-C), as for the main instance */
+  nr_rrc_mac_config_req_mib(instance, 0, main->mib, false);
+  /* nr_rrc_mac_config_req_sib1() takes over parts of the SIB1 it is given, as from the RRC: give it its own copy */
+  NR_SIB1_t *sib1 = NULL;
+  asn_copy(&asn_DEF_NR_SIB1, (void **)&sib1, sniffer_sib1);
+  nr_rrc_mac_config_req_sib1(instance, 0, sib1, false);
+  SEQUENCE_free(&asn_DEF_NR_SIB1, sib1, ASFM_FREE_EVERYTHING);
+  nr_rrc_mac_config_req_cg(instance, 0, 0, 0, cell_group, NULL);
