+/* nr-sniffer: true if PDCCH configurations a and b differ at most in their RNTI: same CORESET, scrambling,
+ * candidates and DCI sizes, so one demodulation and one polar decoding per candidate serve both */
+static bool same_pdcch_config(const fapi_nr_dl_config_dci_dl_pdu_rel15_t *a, const fapi_nr_dl_config_dci_dl_pdu_rel15_t *b)
+{
+  const fapi_nr_coreset_t *ca = &a->coreset, *cb = &b->coreset;
+  if (a->BWPSize != b->BWPSize || a->BWPStart != b->BWPStart || a->SubcarrierSpacing != b->SubcarrierSpacing
+      || a->ss_id != b->ss_id || a->coreset_id != b->coreset_id || a->number_of_candidates != b->number_of_candidates
+      || a->num_dci_options != b->num_dci_options)
+    return false;
+  if (memcmp(ca->frequency_domain_resource, cb->frequency_domain_resource, sizeof(ca->frequency_domain_resource))
+      || ca->rb_offset != cb->rb_offset || ca->StartSymbolBitmap != cb->StartSymbolBitmap || ca->duration != cb->duration
+      || ca->CceRegMappingType != cb->CceRegMappingType || ca->RegBundleSize != cb->RegBundleSize
+      || ca->InterleaverSize != cb->InterleaverSize || ca->ShiftIndex != cb->ShiftIndex || ca->CoreSetType != cb->CoreSetType
+      || ca->precoder_granularity != cb->precoder_granularity || ca->pdcch_dmrs_scrambling_id != cb->pdcch_dmrs_scrambling_id
+      || ca->scrambling_rnti != cb->scrambling_rnti)
+    return false;
+  for (int i = 0; i < a->number_of_candidates; i++)
+    if (a->CCE[i] != b->CCE[i] || a->L[i] != b->L[i])
+      return false;
+  for (int i = 0; i < a->num_dci_options; i++)
+    if (a->dci_length_options[i] != b->dci_length_options[i] || a->dci_format_options[i] != b->dci_format_options[i]
+        || a->ss_type_options[i] != b->ss_type_options[i])
+      return false;
+  return true;
+}
