diff --git a/common/utils/nr_sniffer_hooks.h b/common/utils/nr_sniffer_hooks.h
new file mode 100644
index 0000000..15ebe18
--- /dev/null
+++ b/common/utils/nr_sniffer_hooks.h
@@ -0,0 +1,193 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*! \file nr_sniffer_hooks.h
+ * \brief Optional hooks used by the nr-sniffer passive telemetry tool.
+ *
+ * The functions below are declared weak. They are only defined by the
+ * nr-sniffer executable. In every other OAI executable (nr-uesoftmodem,
+ * nr-softmodem, ...) they resolve to NULL, the wrappers below do nothing,
+ * and behaviour is unchanged.
+ */
+
+#ifndef NR_SNIFFER_HOOKS_H
+#define NR_SNIFFER_HOOKS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct configmodule_interface configmodule_interface_t;
+
+/// most shadow MAC instances (followed UEs) the UE MAC asks the sniffer for
+#define NR_SNIFFER_MAX_SHADOWS 16
+
+/// MIB content as decoded by the UE MAC, plus PHY-level cell information.
+typedef struct {
+  int sfn; ///< full 10-bit system frame number
+  int ssb_index; ///< SSB index of the decoded block
+  int half_frame; ///< half-frame bit
+  int pci; ///< physical cell ID from PSS/SSS
+  int ssb_subcarrier_offset; ///< k_SSB (incl. MSB for FR1)
+  int ssb_start_subcarrier; ///< first subcarrier of the SSB in the receiver grid
+  int scs_common; ///< subCarrierSpacingCommon (0: 15/60 kHz, 1: 30/120 kHz)
+  int dmrs_typeA_pos; ///< 0: pos2, 1: pos3
+  int coreset0; ///< pdcch-ConfigSIB1.controlResourceSetZero
+  int searchspace0; ///< pdcch-ConfigSIB1.searchSpaceZero
+  int cell_barred; ///< 0: barred, 1: notBarred (ASN.1 enumeration)
+  int intra_freq_reselection; ///< 0: allowed, 1: notAllowed
+  bool fr2; ///< true if the SSB burst has 64 positions
+} nr_sniffer_mib_t;
+
+/// One DCI with the PDSCH/PUSCH allocation it schedules (the nr-sniffer DCI CSV schema).
+typedef struct {
+  uint64_t timestamp_us;
+  int sfn, slot; ///< frame and slot the PDCCH was received in
+  int rnti;
+  int rnti_type; ///< nr_rnti_type_t
+  int dci_format; ///< nr_dci_format_t
+  int bwp_id, coreset_id, ss_id;
+  int aggregation_level, cce_index;
+  int prb_start, prb_len; ///< prb_start relative to the BWP start
+  int mcs;
+  int mcs_table; ///< FAPI mcsTable / mcs_table index
+  int tbs_bits;
+  int ndi, rv, harq_id;
+} nr_sniffer_dci_t;
+
+void nr_sniffer_init(configmodule_interface_t *cfg) __attribute__((weak));
+void nr_sniffer_on_mib(const nr_sniffer_mib_t *mib) __attribute__((weak));
+/// \p sib1 is a const NR_SIB1_t *; void * keeps this header free of ASN.1 includes.
+void nr_sniffer_on_sib1(const void *sib1, int frame, int slot) __attribute__((weak));
+bool nr_sniffer_is_passive(void) __attribute__((weak));
+/// UE MAC decoded a DCI (any RNTI) and prepared the PDSCH/PUSCH it schedules.
+void nr_sniffer_on_dci(const nr_sniffer_dci_t *dci) __attribute__((weak));
+/// UE PHY: true if a PDCCH candidate decoded with the configuration for \p cfg_rnti has a CRC remainder \p crc
+/// equal to an RNTI the sniffer tracks for that configuration (other UEs' RA-RNTI / TC-RNTI).
+bool nr_sniffer_match_rnti(uint16_t cfg_rnti, uint32_t crc) __attribute__((weak));
+/// UE MAC: nr_rnti_type_t of an RNTI the sniffer tracks, or -1.
+int nr_sniffer_rnti_type(uint16_t rnti) __attribute__((weak));
+/// UE MAC: RNTI to configure the RA search space with to watch other UEs' random access, or 0 for none.
+uint16_t nr_sniffer_ra_watch_rnti(void) __attribute__((weak));
+/// UE MAC: a RAR MAC PDU was decoded on a tracked RA-RNTI.
+void nr_sniffer_on_rar(const uint8_t *pdu, int len, int frame, int slot) __attribute__((weak));
+/// UE MAC: a DL-SCH MAC PDU decoded by the sniffer's own MAC. Returns true if it is another UE's Msg4 (it holds a
+/// UE Contention Resolution Identity CE): the PDU is the sniffer's, and its RRCSetup must not reach this UE's RRC.
+/// If the sniffer follows that UE, \p rnti, \p cell_group (an NR_CellGroupConfig_t *, from the RRCSetup; the
+/// caller applies and frees it) and \p instance (the shadow MAC instance for that UE) are set.
+bool nr_sniffer_on_msg4(const uint8_t *pdu, int len, int frame, int slot, uint16_t *rnti, void **cell_group, int *instance)
+    __attribute__((weak));
+/// UE MAC, once SIB1 is applied: a UE to follow with a known configuration. Returns a NR_CellGroupConfig_t *
+/// (the caller applies and frees it) and sets \p rnti and \p instance (its shadow MAC instance), once; else NULL.
+void *nr_sniffer_known_ue(uint16_t *rnti, int *instance) __attribute__((weak));
+/// UE MAC: shadow MAC instance following \p rnti, or -1.
+int nr_sniffer_shadow_instance(uint16_t rnti) __attribute__((weak));
+/// UE MAC: the shadow MAC instances of all followed UEs (at most \p max). Returns their number.
+int nr_sniffer_shadow_instances(int *instances, int max) __attribute__((weak));
+/// UE MAC: fold PDCCH configurations of followed UEs that differ only in the RNTI into one (--sniffer.merge_pdcch).
+bool nr_sniffer_merge_pdcch(void) __attribute__((weak));
+/// UE MAC, once per slot: \p nb_configs PDCCH configurations go to the PHY, \p nb_merged others were folded into them.
+void nr_sniffer_on_slot(int frame, int slot, int nb_configs, int nb_merged) __attribute__((weak));
+/// UE SIB1 as last decoded (a const NR_SIB1_t *), to configure shadow MAC instances; NULL before SIB1.
+const void *nr_sniffer_sib1(void) __attribute__((weak));
+
+static inline void nr_sniffer_hook_init(configmodule_interface_t *cfg)
+{
+  if (nr_sniffer_init)
+    nr_sniffer_init(cfg);
+}
+
+static inline void nr_sniffer_hook_mib(const nr_sniffer_mib_t *mib)
+{
+  if (nr_sniffer_on_mib)
+    nr_sniffer_on_mib(mib);
+}
+
+static inline void nr_sniffer_hook_sib1(const void *sib1, int frame, int slot)
+{
+  if (nr_sniffer_on_sib1)
+    nr_sniffer_on_sib1(sib1, frame, slot);
+}
+
+/// True when running as a passive sniffer: the UE stack must never start random access or transmit.
+static inline bool nr_sniffer_passive(void)
+{
+  return nr_sniffer_is_passive && nr_sniffer_is_passive();
+}
+
+static inline void nr_sniffer_hook_dci(const nr_sniffer_dci_t *dci)
+{
+  if (nr_sniffer_on_dci)
+    nr_sniffer_on_dci(dci);
+}
+
+static inline bool nr_sniffer_hook_match_rnti(uint16_t cfg_rnti, uint32_t crc)
+{
+  return nr_sniffer_match_rnti && nr_sniffer_match_rnti(cfg_rnti, crc);
+}
+
+static inline int nr_sniffer_hook_rnti_type(uint16_t rnti)
+{
+  return nr_sniffer_rnti_type ? nr_sniffer_rnti_type(rnti) : -1;
+}
+
+static inline uint16_t nr_sniffer_hook_ra_watch_rnti(void)
+{
+  return nr_sniffer_ra_watch_rnti ? nr_sniffer_ra_watch_rnti() : 0;
+}
+
+/// Returns true if the sniffer consumed the RAR (the UE's own RA procedure must not process it).
+static inline bool nr_sniffer_hook_rar(const uint8_t *pdu, int len, int frame, int slot)
+{
+  if (!nr_sniffer_on_rar || !nr_sniffer_passive())
+    return false;
+  nr_sniffer_on_rar(pdu, len, frame, slot);
+  return true;
+}
+
+static inline void *nr_sniffer_hook_known_ue(uint16_t *rnti, int *instance)
+{
+  return nr_sniffer_known_ue ? nr_sniffer_known_ue(rnti, instance) : NULL;
+}
+
+static inline bool nr_sniffer_hook_msg4(const uint8_t *pdu, int len, int frame, int slot, uint16_t *rnti, void **cg, int *instance)
+{
+  return nr_sniffer_on_msg4 && nr_sniffer_passive() && nr_sniffer_on_msg4(pdu, len, frame, slot, rnti, cg, instance);
+}
+
+static inline int nr_sniffer_hook_shadow_instance(uint16_t rnti)
+{
+  return nr_sniffer_shadow_instance ? nr_sniffer_shadow_instance(rnti) : -1;
+}
+
+static inline int nr_sniffer_hook_shadow_instances(int *instances, int max)
+{
+  return nr_sniffer_shadow_instances ? nr_sniffer_shadow_instances(instances, max) : 0;
+}
+
+static inline bool nr_sniffer_hook_merge_pdcch(void)
+{
+  return nr_sniffer_merge_pdcch && nr_sniffer_merge_pdcch();
+}
+
+static inline void nr_sniffer_hook_slot(int frame, int slot, int nb_configs, int nb_merged)
+{
+  if (nr_sniffer_on_slot)
+    nr_sniffer_on_slot(frame, slot, nb_configs, nb_merged);
+}
+
+static inline const void *nr_sniffer_hook_get_sib1(void)
+{
+  return nr_sniffer_sib1 ? nr_sniffer_sib1() : NULL;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
